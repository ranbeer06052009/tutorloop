# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/tutorloop?retryWrites=true&w=majority

# Local open-weight Gemma via Ollama (preferred)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Hosted Gemma on Google AI Studio / Gemini API (used on Render when Ollama is unreachable)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-12b-it

# Optional: return a canned pack so the UI can be demoed without a model
# DEMO_MODE=true
